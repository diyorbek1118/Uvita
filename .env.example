APP_NAME=Uvita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Courier push (Firebase Cloud Messaging HTTP v1)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
COURIER_PIN_MAX_ATTEMPTS=5
COURIER_PIN_BLOCK_MINUTES=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

CUSTOMER_TOKEN_EXPIRATION_DAYS=30
STAFF_TOKEN_EXPIRATION_HOURS=12

# Seller economics (percentage of listed product price)
SELLER_PLATFORM_FEE_PERCENT=10
SELLER_COURIER_FEE_PERCENT=5
SELLER_TAX_PERCENT=1
SELLER_PAYMENT_FEE_PERCENT=3

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=public
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PEXELS_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_COURIER_CHAT_IDS=
TELEGRAM_REQUIRED=false

# SMS: log (local), eskiz yoki generic http gateway
SMS_DRIVER=log
SMS_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_CALLBACK_URL=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TOKEN_HEADER=Authorization
SMS_HTTP_TOKEN_PREFIX=Bearer
SMS_HTTP_PHONE_FIELD=phone
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_FROM_FIELD=from

# Payment providers
PAYMENT_TEST_MODE=true
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_USERNAME=
UZUM_PASSWORD=
UZUM_CHECKOUT_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
API_RATE_LIMIT_PER_MINUTE=300
