SMS_HTTP_TOKEN_PREFIX=Bearer
SMS_HTTP_PHONE_FIELD=phone
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_FROM_FIELD=from

TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_COURIER_CHAT_IDS=
