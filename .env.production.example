APP_NAME=Uvita
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.uz
APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=uvita
DB_USERNAME=uvita
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_BLOCK_FOR=5

FILESYSTEM_DISK=local
UPLOAD_DISK=public

CUSTOMER_TOKEN_EXPIRATION_DAYS=30
STAFF_TOKEN_EXPIRATION_HOURS=12
SELLER_PLATFORM_FEE_PERCENT=10
SELLER_COURIER_FEE_PERCENT=5
SELLER_TAX_PERCENT=1
SELLER_PAYMENT_FEE_PERCENT=3
API_RATE_LIMIT_PER_MINUTE=300
CORS_ALLOWED_ORIGINS=https://example.uz

